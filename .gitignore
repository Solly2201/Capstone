node_modules/
dist/
.env
.env.*
!.env.example
coverage/
__pycache__/
*.py[cod]
.pytest_cache/
.venv/
data/uploads/
data/legal-corpus/


# AI service build artifacts -- regenerate with:
#   python services/ai/scripts/ingest_corpus.py
services/ai/data/index/
services/ai/data/legal-corpus/*/chunks.jsonl
services/ai/data/legal-corpus/*/source.json
services/ai/.venv/
services/ai/__pycache__/
services/ai/**/__pycache__/

# Fine-tuned embedding model checkpoints and candidate dense-vector
# caches -- reproducible from services/ai/finetune/train.py, never
# committed (see docs/RETRIEVAL_EVALUATION.md's fine-tuning section).
services/ai/finetune/output/
# Deployed local embedding-model artifacts (e.g. data/models/m12_run2):
# same policy as the index above -- a build artifact regenerated by
# finetune/train.py, distributed outside git (see the M13 section of
# docs/RETRIEVAL_EVALUATION.md for the exact reproduction steps).
services/ai/data/models/
# sentence-transformers' Trainer writes default TensorBoard run logs
# here (its own default output_dir when not overridden) -- log noise,
# not a real artifact.
services/ai/checkpoints/

# Claude Code local state
.claude/

# TypeScript incremental build state, written by `tsc -b` / `tsc -p`
# whenever the workspaces are typechecked or built. Regenerated on
# demand and machine-specific, so it is never committed.
*.tsbuildinfo
