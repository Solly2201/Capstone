# Docker Compose overrides. Copy to .env (which is gitignored) to change
# anything below; every value has a working local default, so an empty
# .env is fine for local development.
#
# Never commit a real secret to this file or to .env.

NODE_ENV=development

# Required in production. The API refuses to start if this is left as the
# development placeholder while NODE_ENV=production. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=local-development-secret-change-before-production

# Browser origin allowed by CORS. Must name the deployed web origin in
# production; a wildcard is rejected.
WEB_ORIGIN=http://localhost:5173

# Service addresses inside the compose network.
MONGODB_URI=mongodb://mongo:27017/cap
REDIS_URL=redis://redis:6379
AI_SERVICE_URL=http://ai:8000

# Dense embedding model for legal retrieval. The production value is the
# promoted fine-tuned artifact (services/ai/data/models/m12_run2,
# reproduced by services/ai/finetune/train.py -- see the M13 section of
# docs/RETRIEVAL_EVALUATION.md). Changing it means re-running
#   python services/ai/scripts/ingest_corpus.py
# from services/ai; the service then follows index_manifest.json.
# DENSE_EMBEDDING_MODEL=data/models/m12_run2

# Optional SMTP transport for verification email, e.g.
#   SMTP_URL=smtp://user:password@mail.example:587
# Unset: development returns the verification token in the API response;
# production answers 503 to self-registration rather than issuing a
# challenge nobody can receive.
# SMTP_URL=
# MAIL_FROM=CAP <no-reply@cap.local>
